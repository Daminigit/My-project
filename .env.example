# ============================================
# AI-Powered Restaurant Recommendation System
# Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM API Keys (use at least one) ---
GROQ_API_KEY=

# --- LLM Configuration ---
LLM_PROVIDER=groq          # Options: groq
LLM_MODEL=llama3-8b-8192      # Options: llama3-8b-8192, mixtral-8x7b-32768, etc.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# --- Application ---
APP_NAME=Zomato AI Recommender
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# --- Data ---
DATASET_NAME=ManikaSaini/zomato-restaurant-recommendation
DATA_CACHE_PATH=data/zomato_cleaned.csv
TOP_N_CANDIDATES=20           # Max restaurants sent to LLM
TOP_N_RECOMMENDATIONS=5       # Max recommendations returned

# --- Cache ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600        # 1 hour
CACHE_MAX_ENTRIES=1000

# --- Rate Limiting ---
RATE_LIMIT=10/minute
